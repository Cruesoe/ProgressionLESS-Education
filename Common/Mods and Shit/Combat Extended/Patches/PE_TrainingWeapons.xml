<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- The Patched tag keeps CE's gun autopatcher off these weapons: shooting lessons spawn their vanilla Projectile directly -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="PE_Gun_AssaultRifleTraining" or defName="PE_PracticeShortBow" or defName="PE_Gun_SpacerTraining"]</xpath>
    <value>
      <weaponTags>
        <li>Patched</li>
      </weaponTags>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="PE_Gun_AssaultRifleTraining" or defName="PE_Gun_SpacerTraining"]/tools</xpath>
    <value>
      <tools>
        <li Class="CombatExtended.ToolCE">
          <label>stock</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>9</power>
          <cooldownTime>2</cooldownTime>
          <armorPenetrationBlunt>2.755</armorPenetrationBlunt>
        </li>
        <li Class="CombatExtended.ToolCE">
          <label>barrel</label>
          <capacities>
            <li>Blunt</li>
            <li>Poke</li>
          </capacities>
          <power>9</power>
          <cooldownTime>2</cooldownTime>
          <armorPenetrationBlunt>1.630</armorPenetrationBlunt>
        </li>
      </tools>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="PE_PracticeShortBow"]/tools</xpath>
    <value>
      <tools>
        <li Class="CombatExtended.ToolCE">
          <label>limb</label>
          <capacities>
            <li>Blunt</li>
            <li>Poke</li>
          </capacities>
          <power>9</power>
          <cooldownTime>2</cooldownTime>
          <armorPenetrationBlunt>0.65</armorPenetrationBlunt>
        </li>
      </tools>
    </value>
  </Operation>

</Patch>
