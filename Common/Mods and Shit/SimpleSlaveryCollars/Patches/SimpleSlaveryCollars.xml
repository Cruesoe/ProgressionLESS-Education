<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Electric and crypto collars resolve to Spacer or higher, which would need high-tech proficiency to wear -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="Apparel_SlaveCollar_Electric" or defName="Apparel_SlaveCollar_Crypto"]</xpath>
    <value>
      <li Class="ProgressionEducation.ItemProficiencyRequirement">
        <requiredProficiency>PE_LowTechProficiency</requiredProficiency>
      </li>
    </value>
  </Operation>
</Patch>
